@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
# 发行 SDK 可携带独立依赖前缀；局部作用域不污染宿主的查找设置。
function(_tansr_sdk_find_dependencies)
  set(TansrSDK_FOUND FALSE PARENT_SCOPE)
  if(EXISTS "${PACKAGE_PREFIX_DIR}/dependencies" AND NOT TansrSDK_NO_BUNDLED_DEPENDENCIES)
    list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}/dependencies")
    set(OPENSSL_ROOT_DIR "${PACKAGE_PREFIX_DIR}/dependencies")
    set(OPENSSL_USE_STATIC_LIBS TRUE)
  endif()
  find_dependency(CURL 8.0)
  find_dependency(OpenSSL 3.5 COMPONENTS Crypto)
  find_dependency(Threads)
  set(TansrSDK_FOUND TRUE PARENT_SCOPE)
endfunction()
_tansr_sdk_find_dependencies()
if(NOT TansrSDK_FOUND)
  set(TansrSDK_NOT_FOUND_MESSAGE "TansrSDK requires matching curl, OpenSSL Crypto and thread dependencies")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TansrSDKTargets.cmake")
check_required_components(TansrSDK)
